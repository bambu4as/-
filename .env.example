# ── Telegram / Pocket Option ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
ALLOWED_USERS=

# URL сервера Pocket Option (демо-сервер Європа)
PO_WS_URL=

# Рядок автентифікації (отримайте СВІЖИЙ через консоль браузера!)
# Формат: 42["auth",{"session":"...","isDemo":true,"uid":12345,"platform":1,"isFastHistory":true,"isOptimized":true}]
PO_AUTH_STRING=

PORT=
WEBAPP_URL=

# Выплата брокера (по умолчанию из config/segments.json)
# PAYOUT=0.80

# ── Ядро решения: локальная LLM по сегментам ─────────────────────────
# Сегменты и признаки: config/segments.json
# Сегмент определяется по имени пары: OTC в имени -> otc, иначе currency.
# У каждого сегмента свой сервис (свой порт и своя модель). Сервис деревьев (ml/tree_server.py)
# отвечает только для одобренного сегмента (см. ml/README.md):
#   ML_SEGMENT=currency LLM_PORT=8787 python3 ml/tree_server.py
#   ML_SEGMENT=otc      LLM_PORT=8788 python3 ml/tree_server.py
# Альтернатива: LLM_SEGMENT=... python3 llm/llm_server.py (та же схема запроса)
LLM_URL_CURRENCY=http://127.0.0.1:8787/decide
LLM_URL_OTC=http://127.0.0.1:8788/decide
# Адрес по умолчанию, если сегментный не задан
LLM_URL=http://127.0.0.1:8787/decide

# CPU-инференс 3B-модели может занимать секунды
LLM_TIMEOUT_MS=30000

# 0 — только returns (текущая проверенная конфигурация)
# 1 — добавить индикаторы (включать только вместе с обучением на тех же признаках)
LLM_USE_INDICATORS=0

# Журналы решений: 0 — отключить
# LLM_JOURNAL=0
